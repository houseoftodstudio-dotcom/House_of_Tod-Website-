# House of Tod Studio Environment Configuration

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection String (Required for Vercel Deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/houseoftod?retryWrites=true&w=majority
MONGODB_URI=

# Session Security Secret Key
SESSION_SECRET=houseoftod_secure_session_secret_key_2026_994827

# Admin Default Credentials (used on initial seed)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
